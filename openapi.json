{
  "openapi": "3.0.0",
  "info": {
    "title": "Loan Monitoring API Documentation",
    "version": "1.0.0",
    "description": "This is the API documentation for the High-Risk Loan Application Monitoring System."
  },
  "server": [
    {
      "url": "http://localhost:3000/api/v1",
      "description": "Local Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Loan": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The unique identifier for a loan"
          },
          "description": {
            "type": "string",
            "description": "The purpose stated for the loan"
          },
          "amount": {
            "type": "number",
            "description": "Amount of the loan"
          },
          "createdAt": {
            "type": "date-time",
            "description": "The timestamp when the loan is created"
          }
        }
      }
    }
  },
  "paths": {
    "/api/v1/loans/": {
      "post": {
        "summary": "Allows a user to create a loan",
        "tags": [
          "Loan"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Loan"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Loan Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Loan"
                }
              }
            }
          },
          "401": {
            "description": "Invalid Token"
          },
          "403": {
            "description": "Insufficient Role"
          }
        }
      },
      "get": {
        "summary": "Allows an officer or manager to retrive all loans",
        "tags": [
          "Loan"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "A list of loans",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Loan"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid Token"
          },
          "403": {
            "description": "Insufficient Role"
          }
        }
      }
    },
    "/api/v1/loans/{id}/review": {
      "put": {
        "summary": "Allows an officer to review a loan",
        "tags": [
          "Loan"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Loan ID to be reviewed"
          }
        ],
        "responses": {
          "200": {
            "description": "Loan Reviewed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Loan"
                }
              }
            }
          },
          "401": {
            "description": "Invalid Token"
          },
          "403": {
            "description": "Insufficient Role"
          }
        }
      }
    },
    "/api/v1/loans/{id}/approve": {
      "put": {
        "summary": "Allows a manager to approve a loan",
        "tags": [
          "Loans"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Loan ID to be approved"
          }
        ],
        "responses": {
          "200": {
            "description": "Loan Approved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Loan"
                }
              }
            }
          },
          "401": {
            "description": "Invalid Token"
          },
          "403": {
            "description": "Insufficient Role"
          }
        }
      }
    }
  },
  "tags": []
}